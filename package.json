{
  "name": "game-ground",
  "version": "1.0.0",
  "description": "게임그라운드: 친구들과 모여 한판, 온라인 보드게임 카페",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/games.test.ts && tsx test/flow.test.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "express": "^5.3.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
